{
  "name": "cycloneguard-backend",
  "version": "1.0.0",
  "description": "CycloneGuard Backend - Real-Time Disaster Management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql && cp src/db/seed.sql dist/db/seed.sql",
    "start": "node dist/index.js",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "test": "tsx src/tests/run-tests.ts"
  },
  "keywords": [
    "cyclone",
    "disaster-management",
    "weather",
    "open-meteo",
    "imd",
    "express",
    "typescript"
  ],
  "author": "CycloneGuard Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^9.11.1",
    "pg": "^8.13.3",
    "redis": "^4.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
