# CycloneGuard Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database
# If running locally via Docker Compose or standalone Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cycloneguard
DB_USER=cyclone_user
DB_PASSWORD=cyclone_secure_password
# Or full connection string:
# DATABASE_URL=postgresql://cyclone_user:cyclone_secure_password@localhost:5432/cycloneguard

# Redis Cache
# Used to cache external API responses to avoid rate limits and reduce latency
REDIS_URL=redis://localhost:6379
WEATHER_CACHE_TTL_SECONDS=600

# External APIs
# Open-Meteo (Live weather and forecasts - Public, no API key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_FETCH_TIMEOUT_MS=7000

# India Meteorological Department (IMD) API
# Register at: https://api.imd.gov.in
# An official API key is required from IMD portal for live RSMC cyclone tracks/warnings.
# Leave blank or unconfigured to operate in transparent 'PENDING_CREDENTIALS' mode.
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
IMD_API_TIMEOUT_MS=8000

# MongoDB Database (MERN Stack Core Integration)
# Used for Disaster Relief Inventory & Shelter Resource Management
# For local MongoDB: mongodb://127.0.0.1:27017/cycloneguard
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/cycloneguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cycloneguard
MONGODB_DB_NAME=cycloneguard
